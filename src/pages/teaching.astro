---
import BaseLayout from "../layouts/BaseLayout.astro";

const dept = "Department of Economics and Management, University of Padova";

// Optional per course: lectures (title + url of a PDF in /public/teaching/...).
type Course = { course: string; level: string; role: string; lectures?: { title: string; url: string }[] };

const years: { year: string; courses: Course[] }[] = [
  {
    year: "2026–2027",
    courses: [
      {
        course: "Econometrics",
        level: "Preparatory course for all Master's Degree programs",
        role: "Lecturer",
        lectures: [
          { title: "The Simple Linear Regression Model", url: "/teaching/econometrics/Lecture_1_Simple_Linear_Regression.pdf" },
          { title: "The Multiple Linear Regression Model", url: "/teaching/econometrics/Lecture_2_Multiple_Linear_Regression.pdf" },
          { title: "Inference", url: "/teaching/econometrics/Lecture_3_Inference.pdf" },
          { title: "Heteroskedasticity", url: "/teaching/econometrics/Lecture_4_Heteroskedasticity.pdf" },
          { title: "Difference Equations", url: "/teaching/econometrics/Lecture_5_Difference_Equations.pdf" },
        ],
      },
    ],
  },
  {
    year: "2025–2026",
    courses: [
      { course: "Applied Microeconomics and Strategic Behavior", level: "Master's Degree in Applied Economics", role: "Teaching Assistant and Co-instructor" },
      { course: "Economics", level: "Preparatory course for all Master's Degree programs", role: "Lecturer" },
    ],
  },
  {
    year: "2024–2025",
    courses: [
      { course: "Applied Microeconomics and Strategic Behavior", level: "Master's Degree in Applied Economics", role: "Teaching Assistant" },
      { course: "Microeconomia", level: "Bachelor's Degree in Economics", role: "Teaching Assistant" },
    ],
  },
  {
    year: "2023–2024",
    courses: [
      { course: "Applied Microeconomics and Strategic Behavior", level: "Master's Degree in Applied Economics", role: "Teaching Assistant" },
    ],
  },
];

---

<BaseLayout title="Teaching | Markeljan Blacëri" sideBarActiveItemID="teaching">
  <div class="text-4xl w-full font-bold mb-2">Teaching</div>
  <div class="opacity-75 mb-8">{dept}</div>

  {
    years.map((y) => (
      <div class="mb-8">
        <div class="text-2xl font-bold mb-3">A.Y. {y.year}</div>
        <ul class="grid gap-3">
          {y.courses.map((c) => (
            <li class="border-l-2 border-primary pl-4">
              <div class="font-semibold text-lg">{c.course}</div>
              <div class="text-sm opacity-75">{c.level}</div>
              <div class="text-sm">{c.role}</div>
              {c.lectures && c.lectures.length > 0 && (
                <div class="mt-2">
                  <div class="text-sm font-semibold mb-1">Lecture notes</div>
                  <ol class="list-decimal ml-5 grid gap-1">
                    {c.lectures.map((l) => (
                      <li class="text-sm"><a class="link-blue" href={l.url} target="_blank">{l.title}</a></li>
                    ))}
                  </ol>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }

</BaseLayout>
