---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SHOW_DATA_PAGE } from "../config";
import DataChart from "../components/charts/DataChart.astro";
import mpData from "../data/charts/monetary_policy.json";
import fgData from "../data/charts/fiscal_forni_gambetti.json";
import riccoData from "../data/charts/fiscal_ricco.json";

// ---- charts (data come from scripts/make_data_figures.py) ----
const BLUE = "#2a78d6", ORANGE = "#eb6834";
const AGGS = [{ key: "mean", label: "Mean" }, { key: "median", label: "Median" }];
type Src = { t: string[]; x: number[]; cols: Record<string, (number | null)[]> };
// one bar view per (measure, mean/median); `col` maps a measure key to its Excel column prefix
function barViews(src: Src, measures: { key: string; col: string }[], yLabel: string) {
  return measures.flatMap((m) =>
    AGGS.map((a) => ({
      key: `${m.key}|${a.key}`,
      kind: "bar" as const,
      yLabel,
      series: [{ name: `${m.col} (${a.key})`, color: BLUE, values: src.cols[`${m.col} (${a.key})`] }],
    }))
  );
}
const mpChart = {
  t: mpData.t, x: mpData.x, xMin: 1990.6, xMax: 2021.4, decimals: 3,
  views: [{ key: "both", kind: "line" as const, series: [
    { name: "MPI", color: BLUE, values: mpData.cols["MPI"] },
    { name: "INFO", color: ORANGE, values: mpData.cols["INFO"] },
  ] }],
  caption: "Monthly. Hover over or tap the chart to see the values.",
};
const fiscalCharts = [
  {
    title: "Forni and Gambetti (2016)",
    t: fgData.t, x: fgData.x, xMin: 1981, xMax: 2027, decimals: 2,
    controls: [
      { options: [{ key: "news", label: "News, next 3 quarters" }, { key: "exp", label: "Expected growth, next 4 quarters" }] },
      { options: AGGS },
    ],
    defaultView: "news|mean",
    views: barViews(fgData as Src, [{ key: "news", col: "n(1,3)" }, { key: "exp", col: "F(1,4)" }], "annualized %"),
  },
  {
    title: "Ricco (2015)",
    t: riccoData.t, x: riccoData.x, xMin: 1981, xMax: 2027, decimals: 2,
    controls: [
      { options: [{ key: "news13", label: "News, next 3 quarters" }, { key: "news0", label: "News, current quarter" }, { key: "nowcast", label: "Nowcast error" }] },
      { options: AGGS },
    ],
    defaultView: "news13|mean",
    caption: "Quarterly. Use the buttons to switch series; hover over or tap a chart to see the values.",
    views: barViews(riccoData as Src, [{ key: "news13", col: "N(1,3)" }, { key: "news0", col: "N(0)" }, { key: "nowcast", col: "M" }], "annualized %"),
  },
];

// Add one entry per series. Put the files in /public/data/ and link them as "/data/<file name>".
// Fields:
//   name         – what the series is (e.g. "Oil supply news shocks")
//   description  – one or two sentences on what was updated
//   coverage     – sample period and frequency (e.g. "1975M1–2026M9, monthly")
//   references   – optional: the original paper(s) the series come from: citation text + optional link
//   variables    – optional list of variable definitions, shown in a collapsible box
//   notes        – optional extra lines shown under the variable definitions (units, dating, …)
//   charts       – optional interactive charts (see the chart definitions above)
//   files        – download links (label + url)
type Ref = { text: string; url?: string };
type Dataset = {
  id?: string;
  name: string;
  description: string;
  coverage?: string;
  references?: Ref[];
  variables?: { group?: string; items: { name: string; def: string }[] }[];
  notes?: string[];
  charts?: any[]; // DataChart props (+ optional title), defined above
  files: { label: string; url: string }[];
};

const datasets: Dataset[] = [
  {
    id: "monetary-policy",
    name: "Informationally-robust monetary policy instrument (US)",
    description:
      "Updated series of the informationally-robust instrument for US monetary policy shocks of Miranda-Agrippino and Ricco (2021).",
    coverage: "1991M1–2020M12, monthly",
    charts: [mpChart],
    files: [
      { label: "Excel", url: "/data/MAR_IVs.xlsx" },
      // { label: "Research Note", url: "/data/MAR_IVs_Research_Note.pdf" },  // add when the note is ready
    ],
  },
  {
    id: "fiscal-news",
    name: "Fiscal news proxies from the Survey of Professional Forecasters (US)",
    description:
      "Updated proxies for US government spending shocks built from the Survey of Professional Forecasters: the forecast error of Ramey (2011), the expectation and news measures of Forni and Gambetti (2016), and the news and nowcast-error measures of Ricco (2015). The construction of each series and the references are explained in the research note.",
    coverage: "1981Q3–2026Q3, quarterly",
    charts: fiscalCharts,
    files: [
      { label: "Excel", url: "/data/fiscal_news_proxies.xlsx" },
      { label: "Research Note", url: "/data/Fiscal_Proxies.pdf" },
    ],
  },
];

const lastUpdated = "October 2026";
---

<BaseLayout title="Data | Markeljan Blacëri" sideBarActiveItemID="data" noindex={!SHOW_DATA_PAGE}>
  <div class="text-4xl w-full font-bold mb-2">Data</div>
  <p class="text-lg leading-relaxed mb-8 opacity-90">
    Updated series of instruments and shocks from the literature, extended to recent data. If you use them, please
    cite the original papers, listed with each series or in its research note.
    {lastUpdated && <span class="block text-sm opacity-75 mt-2">Last updated: {lastUpdated}</span>}
  </p>

  {
    datasets.map((d) => (
      <div id={d.id} class="mb-10 border-l-2 border-primary pl-4 scroll-mt-20">
        <h3 class="text-xl font-semibold leading-snug">{d.name}</h3>
        {d.coverage && <div class="text-sm opacity-75 mt-1">{d.coverage}</div>}
        <p class="mt-2 leading-relaxed">{d.description}</p>
        {d.charts && d.charts.map((c) => (
          <div class="mt-4">
            {c.title && <div class="text-sm font-semibold">{c.title}</div>}
            <DataChart {...c} />
          </div>
        ))}
        {d.references && d.references.length > 0 && (
        <div class="mt-2 text-sm">
          <span class="font-semibold">{d.references.length > 1 ? "Original references:" : "Original reference:"}</span>
          {d.references.length > 1 ? (
            <ul class="list-disc ml-5 mt-1 grid gap-1">
              {d.references.map((r) => (
                <li>{r.url ? <a class="link" href={r.url} target="_blank">{r.text}</a> : r.text}</li>
              ))}
            </ul>
          ) : (
            <span>
              {" "}
              {d.references[0].url ? (
                <a class="link" href={d.references[0].url} target="_blank">{d.references[0].text}</a>
              ) : (
                d.references[0].text
              )}
            </span>
          )}
        </div>
        )}
        {d.variables && (
          <details class="mt-3 text-sm">
            <summary class="cursor-pointer font-medium opacity-80">Variable definitions</summary>
            <div class="mt-2 grid gap-3">
              {d.variables.map((g) => (
                <div>
                  {g.group && <div class="font-semibold mb-1">{g.group}</div>}
                  <dl class="grid gap-1">
                    {g.items.map((v) => (
                      <div class="sm:flex sm:gap-3">
                        <dt class="font-mono shrink-0 sm:w-44">{v.name}</dt>
                        <dd class="opacity-90">{v.def}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              ))}
              {d.notes && (
                <ul class="opacity-80 grid gap-1">
                  {d.notes.map((n) => <li>{n}</li>)}
                </ul>
              )}
            </div>
          </details>
        )}
        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3">
          {d.files.map((f) =>
            f.url.endsWith(".pdf") ? (
              <a class="link-blue" href={f.url} target="_blank">{f.label}</a>
            ) : (
              <a class="link-blue" href={f.url} download>{f.label}</a>
            )
          )}
        </div>
      </div>
    ))
  }
</BaseLayout>
