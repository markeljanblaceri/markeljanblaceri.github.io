---
// Interactive bar chart for time series around zero (SVG, no external libraries).
// Hover (or tap) a bar to see its date and value.
export interface Props {
  data: { t: string; x: number; v: number }[];
  xMin: number;
  xMax: number;
  yLabel?: string;
  decimals?: number;
  caption?: string;
  height?: number;
}
const { data, xMin, xMax, yLabel = "", decimals = 3, caption = "", height = 210 } = Astro.props;

const W = 820, H = height;
const m = { top: 12, right: 8, bottom: 34, left: yLabel ? 86 : 66 };
const pw = W - m.left - m.right, ph = H - m.top - m.bottom;

// "nice" y ticks
const vmin = Math.min(0, ...data.map((d) => d.v));
const vmax = Math.max(0, ...data.map((d) => d.v));
const raw = (vmax - vmin) / 4;
const mag = Math.pow(10, Math.floor(Math.log10(raw)));
const step = [1, 2, 2.5, 5, 10].map((k) => k * mag).find((s) => s >= raw) ?? 10 * mag;
const y0 = Math.floor(vmin / step) * step, y1 = Math.ceil(vmax / step) * step;
const yt: number[] = [];
for (let v = y0; v <= y1 + step / 2; v += step) yt.push(+v.toFixed(10));
const sx = (x: number) => m.left + ((x - xMin) / (xMax - xMin)) * pw;
const sy = (v: number) => m.top + ((y1 - v) / (y1 - y0)) * ph;
const xt: number[] = [];
for (let y = Math.ceil(xMin / 5) * 5; y <= xMax; y += 5) xt.push(y);

const slot = data.length > 1 ? (sx(data[1].x) - sx(data[0].x)) : 4;
const bw = Math.max(1, slot * 0.62);
const stepDec = Math.max(0, -Math.floor(Math.log10(step)) + (step / mag === 2.5 ? 1 : 0));
const fmtTick = (v: number) => (v === 0 ? "0" : v.toFixed(stepDec).replace("-", "−"));
---

<figure class="viz-bar mt-3" data-decimals={decimals}>
  <div class="relative">
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto block" role="img" aria-label={caption || "Bar chart"}>
      {yt.map((v) => (
        <g>
          <line x1={m.left} x2={W - m.right} y1={sy(v)} y2={sy(v)} class={v === 0 ? "viz-zero" : "viz-grid"} />
          <text x={m.left - 8} y={sy(v)} dy="0.35em" text-anchor="end" class="viz-tick">{fmtTick(v)}</text>
        </g>
      ))}
      {xt.map((y) => (
        <text x={sx(y)} y={H - 6} text-anchor="middle" class="viz-tick">{y}</text>
      ))}
      {yLabel && (
        <text transform={`translate(16 ${m.top + ph / 2}) rotate(-90)`} text-anchor="middle" class="viz-tick">{yLabel}</text>
      )}
      {data.map((d) => {
        const top = sy(Math.max(0, d.v)), bot = sy(Math.min(0, d.v));
        return <rect x={sx(d.x) - bw / 2} y={top} width={bw} height={Math.max(0.6, bot - top)} class="viz-bar-mark" />;
      })}
      <!-- hover targets: full-height, one slot wide (bigger than the bar) -->
      {data.map((d) => (
        <rect x={sx(d.x) - slot / 2} y={m.top} width={slot} height={ph} class="viz-hit" data-t={d.t} data-v={d.v} data-cx={sx(d.x)} data-cy={sy(d.v)} />
      ))}
      <line class="viz-cross" x1="0" x2="0" y1={m.top} y2={m.top + ph} />
    </svg>
    <div class="viz-tip" role="status" aria-live="polite"></div>
  </div>
  {caption && <figcaption class="text-xs opacity-70 mt-1">{caption}</figcaption>}
</figure>

<style>
  .viz-bar { --viz-blue: #2a78d6; --viz-blue-hi: #1d4ed8; --viz-grid: #ebeae6; --viz-zero: #8a8984; --viz-ink2: #52514e; }
  .viz-grid { stroke: var(--viz-grid); stroke-width: 1; }
  .viz-zero { stroke: var(--viz-zero); stroke-width: 1; }
  .viz-tick { fill: var(--viz-ink2); font-size: 13px; font-family: inherit; }
  .viz-bar-mark { fill: var(--viz-blue); }
  .viz-hit { fill: transparent; cursor: crosshair; }
  .viz-cross { stroke: var(--viz-zero); stroke-width: 1; stroke-dasharray: 3 3; opacity: 0; pointer-events: none; }
  .viz-tip {
    position: absolute; pointer-events: none; opacity: 0; transform: translate(-50%, -110%);
    background: #fff; color: #0b0b0b; border: 1px solid #e2e1dc; border-radius: 6px;
    padding: 4px 8px; font-size: 12px; line-height: 1.3; white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); transition: opacity 80ms;
  }
  .viz-tip b { font-weight: 600; }
  /* phones: the SVG is scaled down, so enlarge its text to stay readable */
  @media (max-width: 640px) {
    .viz-tick { font-size: 24px; }
  }
</style>

<script>
  function initBarCharts() {
    document.querySelectorAll<HTMLElement>(".viz-bar").forEach((fig) => {
      if (fig.dataset.ready) return;
      fig.dataset.ready = "1";
      const svg = fig.querySelector("svg")!;
      const tip = fig.querySelector<HTMLElement>(".viz-tip")!;
      const cross = fig.querySelector<SVGLineElement>(".viz-cross")!;
      const dec = Number(fig.dataset.decimals || 3);
      const show = (r: SVGRectElement) => {
        const vb = svg.viewBox.baseVal, box = svg.getBoundingClientRect();
        const k = box.width / vb.width;
        const cx = Number(r.dataset.cx), cy = Number(r.dataset.cy);
        const v = Number(r.dataset.v);
        cross.setAttribute("x1", String(cx)); cross.setAttribute("x2", String(cx)); cross.style.opacity = "1";
        tip.innerHTML = `<b>${r.dataset.t}</b>&nbsp; ${v.toFixed(dec).replace("-", "−")}`;
        const left = Math.min(Math.max(cx * k, 50), box.width - 50);
        tip.style.left = `${left}px`;
        tip.style.top = `${Math.max(cy * k, 24)}px`;
        tip.style.opacity = "1";
      };
      const hide = () => { tip.style.opacity = "0"; cross.style.opacity = "0"; };
      fig.querySelectorAll<SVGRectElement>(".viz-hit").forEach((r) => {
        r.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") show(r); });
        r.addEventListener("pointerdown", () => show(r));
      });
      // mouse: hide when leaving the chart; touch: keep the value until the next tap elsewhere
      svg.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") hide(); });
      document.addEventListener("pointerdown", (e) => { if (!fig.contains(e.target as Node)) hide(); });
    });
  }
  document.addEventListener("astro:page-load", initBarCharts);
  initBarCharts();
</script>
